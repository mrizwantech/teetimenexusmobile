{
  "expo": {
    "name": "Tee Time Nexus",
    "slug": "tee-time-nexus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "teetimenexus",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.teetimenexus.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Use Bluetooth to unlock the entrance with your phone during an eligible member booking.",
        "NSLocationWhenInUseUsageDescription": "Detect the nearby Kisi entrance reader for secure in-app unlocking. Your location is not sent to Tee Time Nexus.",
        "UIBackgroundModes": [
          "remote-notification",
          "bluetooth-peripheral"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.teetimenexus.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-kisi-sdk",
      "expo-router",
      "expo-apple-authentication",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/teetimenexusspashscreen.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-image",
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "defaultChannel": "ttn-updates",
          "color": "#A1E04C"
        }
      ]
    ],
    "extra": {
      "kisi": {
        "partnerId": 1053
      },
      "router": {},
      "eas": {
        "projectId": "3c0d7365-63df-43f1-8224-ebc4fa480b84"
      }
    }
  }
}
